---
import Layout from '../layouts/Layout.astro';
import { VALIDATOR_ADDRESS } from '../config';
import snapshot from '../data/validators.json';
import { NetworkStats } from '../components/NetworkStats';
import { LiveStats } from '../components/LiveStats';
import { CopyAddress } from '../components/CopyAddress';
import { Button } from '../components/ui/button';
import { Badge } from '../components/ui/badge';
import { Card, CardContent } from '../components/ui/card';

const impact = snapshot.validators.find((v) => v.address.replace(/\s/g, '').includes('ACT8T0FE'));
const totalStaked = snapshot.validators.reduce((s, v) => s + (v.balance || 0), 0);
const totalStakers = snapshot.validators.reduce((s, v) => s + Math.max(v.stakers || 0, 0), 0);
const zeroFee = snapshot.validators.filter((v) => v.fee === 0).length;

function fmtNim(luna: number): string {
  return (luna / 1e5).toLocaleString('en-US', { maximumFractionDigits: 0 });
}
---

<Layout>
  <!-- Hero: split, left pitch / right live stats -->
  <section class="mx-auto grid max-w-6xl gap-10 px-4 pt-16 pb-14 md:grid-cols-2 md:items-center md:pt-20">
    <div>
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-primary">Nimiq validator</p>
      <h1 class="text-4xl font-bold leading-none tracking-tighter md:text-5xl">0% fee.<br />Maximum returns.</h1>
      <p class="mt-4 max-w-[46ch] text-base leading-relaxed text-muted-foreground">
        ImpactZero stake keeps 0% of your rewards, runs on eco-friendly hosting, and stays online. Your NIM, your yield, no middleman.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button asChild size="lg">
          <a href="https://www.nimiq.com/staking" target="_blank" rel="noopener" data-stake-cta="hero">Stake with us</a>
        </Button>
        <Button asChild variant="outline" size="lg">
          <a href="/validators/">Compare validators</a>
        </Button>
      </div>
    </div>

    <Card>
      <CardContent class="px-6 py-6">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-foreground">Live network stats</h2>
          <span class="font-mono text-xs text-muted-foreground">epoch {impact?.score?.epochNumber ?? 'n/a'}</span>
        </div>
        <dl class="mt-5 grid grid-cols-2 gap-4">
          <div>
            <dt class="text-xs text-muted-foreground">Validators</dt>
            <dd class="tabular mt-1 font-mono text-2xl font-semibold text-foreground">{snapshot.validators.length}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted-foreground">Total staked</dt>
            <dd class="tabular mt-1 font-mono text-2xl font-semibold text-foreground">{fmtNim(totalStaked)} NIM</dd>
          </div>
          <div>
            <dt class="text-xs text-muted-foreground">Stakers</dt>
            <dd class="tabular mt-1 font-mono text-2xl font-semibold text-foreground">{totalStakers.toLocaleString()}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted-foreground">0% fee pools</dt>
            <dd class="tabular mt-1 font-mono text-2xl font-semibold text-foreground">{zeroFee}</dd>
          </div>
        </dl>
        <p class="mt-5 border-t border-border pt-4 font-mono text-xs text-muted-foreground">
          Data: validators-api-main.je-cf9.workers.dev, fetched {snapshot.fetchedAt.slice(0, 10)}
        </p>
      </CardContent>
    </Card>
  </section>

  <!-- Why ImpactZero: three facts, no cards -->
  <section class="border-t border-border/80">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-2xl font-bold tracking-tight">Why stake with ImpactZero</h2>
      <div class="mt-8 grid gap-10 md:grid-cols-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Fee</p>
          <p class="mt-2 text-lg font-semibold">0% forever</p>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">Every reward goes to you. No commission, no hidden cuts, no fee creep later.</p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Payouts</p>
          <p class="mt-2 text-lg font-semibold">Restake, automatic</p>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">Rewards are restaked automatically, compounding your position without any action.</p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Hosting</p>
          <p class="mt-2 text-lg font-semibold">Eco-friendly uptime</p>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">Efficient infrastructure keeps the node online with a small footprint.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mini Apps -->
  <section id="apps" class="border-t border-border/80">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-2xl font-bold tracking-tight">Built for the Nimiq ecosystem</h2>
      <p class="mt-2 max-w-[60ch] text-sm text-muted-foreground">
        Two mini apps, live in any browser and inside Nimiq Pay. Open source, MIT.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <Card class="overflow-hidden">
          <a href="https://nimbooks.subimpact.net" target="_blank" rel="noopener" class="group block">
            <div class="relative aspect-[16/9] overflow-hidden bg-zinc-900">
              <img src="/apps/nimbooks-shot.png" alt="NimBooks dashboard screenshot" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
            </div>
            <CardContent class="px-5 py-5">
              <div class="flex items-center gap-3">
                <img src="/apps/nimbooks-icon.png" alt="NimBooks icon" class="h-10 w-10 rounded-lg" />
                <div>
                  <p class="font-semibold text-foreground">NimBooks</p>
                  <p class="text-xs text-muted-foreground">The books for your Nimiq wallet</p>
                </div>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                Balances, history, CSV statements, and cryptographically signed proof-of-payment receipts for NIM and EVM assets. Try the demo mode, no wallet needed.
              </p>
              <p class="mt-3 font-mono text-xs text-primary">nimbooks.subimpact.net</p>
            </CardContent>
          </a>
        </Card>
        <Card class="overflow-hidden">
          <a href="https://darkfall.subimpact.net" target="_blank" rel="noopener" class="group block">
            <div class="relative aspect-[16/9] overflow-hidden bg-zinc-900">
              <img src="/apps/darkfall-shot.png" alt="Darkfall town screenshot" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
            </div>
            <CardContent class="px-5 py-5">
              <div class="flex items-center gap-3">
                <img src="/apps/darkfall-icon.png" alt="Darkfall icon" class="h-10 w-10 rounded-lg" />
                <div>
                  <p class="font-semibold text-foreground">Darkfall</p>
                  <p class="text-xs text-muted-foreground">Pixel action RPG with a player-run economy</p>
                </div>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                Three classes, 8 dungeon depths, randomized loot, and a player-run Trading Post where items trade for NIM, wallet-to-wallet. Free to play.
              </p>
              <p class="mt-3 font-mono text-xs text-primary">darkfall.subimpact.net</p>
            </CardContent>
          </a>
        </Card>
      </div>
    </div>
  </section>

  <!-- Status -->
  <section id="status" class="border-t border-border/80">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-2xl font-bold tracking-tight">Validator status</h2>
      <Card class="mt-6">
        <CardContent class="px-6 py-6">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <p class="text-lg font-semibold">{impact?.name ?? 'ImpactZero stake'}</p>
              <CopyAddress
                client:load
                value={VALIDATOR_ADDRESS}
                label="ImpactZero validator address"
                className="mt-1 text-xs text-muted-foreground"
              />
            </div>
            <Badge variant="outline" class="border-primary/40 text-primary">listed in Nimiq Wallet</Badge>
          </div>
          <div class="mt-6">
            <LiveStats
              client:load
              initialStake={impact?.balance ?? 0}
              initialStakers={impact?.stakers ?? 0}
              initialEpoch={null}
            />
          </div>
          <p class="mt-5 border-t border-border pt-4 text-sm text-muted-foreground">
            The validator is live on-chain. The node is running, synced, and registered in the official Nimiq Validators API. Delegation is open — stake with ImpactZero for 0% fees.
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <a href="https://buymeacoffee.com/subimpact" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-md border border-[#FFDD00]/40 bg-[#FFDD00]/10 px-3.5 py-2 text-sm font-semibold text-[#FFDD00] transition-colors hover:bg-[#FFDD00]/20">
              Support the node on Buy Me a Coffee
            </a>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-border/80">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Ready to stake?</h2>
      <p class="mx-auto mt-2 max-w-[52ch] text-sm text-muted-foreground">Stake right here — connect your account, pick an amount, confirm in the Nimiq Hub, and keep 100% of your rewards.</p>
      <Button asChild size="lg" class="mt-6">
        <a href="https://www.nimiq.com/staking" target="_blank" rel="noopener" data-stake-cta="cta">Stake NIM</a>
      </Button>
    </div>
  </section>
</Layout>
