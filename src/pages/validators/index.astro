---
import Layout from '../../layouts/Layout.astro';
import snapshot from '../../data/validators.json';
import { NetworkStats } from '../../components/NetworkStats';
import { ValidatorsPanel } from '../../components/ValidatorsPanel';

const totalStaked = snapshot.validators.reduce((s, v) => s + (v.balance || 0), 0);
const totalStakers = snapshot.validators.reduce((s, v) => s + Math.max(v.stakers || 0, 0), 0);
const zeroFee = snapshot.validators.filter((v) => v.fee === 0).length;
const avgFee = snapshot.validators.reduce((s, v) => s + (v.fee || 0), 0) / snapshot.validators.length;

function fmtNim(luna: number): string {
  return (luna / 1e5).toLocaleString('en-US', { maximumFractionDigits: 0 });
}
---

<Layout>
  <section class="mx-auto w-full max-w-[1600px] px-4 pt-12 pb-16 md:px-8 xl:px-10">
    <p class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-primary">Network overview</p>
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Nimiq validators, compared</h1>
    <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-muted-foreground">
      Every validator listed in the official Nimiq Validators API, with fees, payout type, trust scores, and stake. Data refreshes live from the API. Switch to <strong class="font-medium text-foreground">Map</strong> for the delegation graph — every validator and every address staking with one.
    </p>

    <div class="mt-8">
      <NetworkStats
        stats={[
          { label: 'Validators', value: String(snapshot.validators.length) },
          { label: 'Total staked', value: fmtNim(totalStaked) + ' NIM' },
          { label: 'Stakers', value: totalStakers.toLocaleString() },
          { label: '0% fee pools', value: String(zeroFee) },
        ]}
      />
    </div>

    <div class="mt-10">
      <ValidatorsPanel initial={snapshot.validators} client:load />
    </div>
  </section>
</Layout>
