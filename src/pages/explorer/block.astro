---
import Layout from '../../layouts/Layout.astro'
import { BlockView } from '../../components/explorer/BlockView'

const title = 'Block — Nimiq Explorer'
const description =
  'A single Nimiq block: hash, parent, producer, size, and every transaction inside — read live from a public node.'
---

<Layout title={title} description={description}>
  <section class="mx-auto w-full max-w-[1200px] px-4 pt-12 pb-24 md:px-8 md:pb-16 xl:px-10">
    <div class="mb-6">
      <a href="/explorer/" class="font-mono text-xs text-muted-foreground transition-colors hover:text-foreground">
        ← Explorer
      </a>
    </div>
    <BlockView client:load />
  </section>
</Layout>
