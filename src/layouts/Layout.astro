---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, VALIDATOR_ADDRESS } from '../config';
import { CopyAddress } from '../components/CopyAddress';
import { StakeDialogHost } from '../components/StakeDialogHost';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src="https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);})(window,document,"script","dataLayer","GTM-N7F72PFX");</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ImpactZero stake" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "ImpactZero stake",
      "url": "https://nimiq.subimpact.net",
      "description": SITE_DESCRIPTION
    })} />
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N7F72PFX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/85 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-md bg-white p-1">
            <img src="/logo.svg" alt="ImpactZero stake logo" class="h-full w-full" />
          </span>
          <span class="text-sm font-semibold tracking-tight">ImpactZero stake</span>
        </a>
        <div class="hidden items-center gap-6 text-sm text-zinc-400 md:flex">
          <a href="/" class="transition-colors hover:text-zinc-100">Pool</a>
          <a href="/validators/" class="transition-colors hover:text-zinc-100">Validators</a>
          <a href="/graph/" class="transition-colors hover:text-zinc-100">Graph</a>
          <a href="/#apps" class="transition-colors hover:text-zinc-100">Apps</a>
          <a href="/#status" class="transition-colors hover:text-zinc-100">Status</a>
        </div>
        <a href="https://www.nimiq.com/staking" target="_blank" rel="noopener" data-stake-cta="nav" class="rounded-md bg-[#07c1ff] px-3.5 py-2 text-sm font-semibold text-zinc-950 transition-transform active:scale-[0.98]">Stake NIM</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-zinc-800/80">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-zinc-500 md:flex-row md:items-center md:justify-between">
        <p>ImpactZero stake. 0% fee, forever.</p>
        <!-- client:load, not client:visible: the footer is the one place people
             reach for the address, and a click must not land before hydration. -->
        <CopyAddress client:load value={VALIDATOR_ADDRESS} label="ImpactZero validator address" className="text-xs" />
        <div class="flex gap-4">
          <a href="/validators/" class="transition-colors hover:text-zinc-300">Validators</a>
          <a href="/graph/" class="transition-colors hover:text-zinc-300">Delegation map</a>
          <a href="https://t.me/subimpact" target="_blank" rel="noopener" class="transition-colors hover:text-zinc-300">Telegram</a>
          <a href="https://x.com/subimpact" target="_blank" rel="noopener" class="transition-colors hover:text-zinc-300">X</a>
          <a href="mailto:nim@subimpact.net" class="transition-colors hover:text-zinc-300">Email</a>
        </div>
      </div>
    </footer>

    <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-zinc-800 bg-zinc-950/95 backdrop-blur md:hidden">
      <div class="grid grid-cols-5 text-center text-xs text-zinc-400">
        <a href="/" class="py-3 transition-colors hover:text-zinc-100">Pool</a>
        <a href="/validators/" class="py-3 transition-colors hover:text-zinc-100">Validators</a>
        <a href="/graph/" class="py-3 transition-colors hover:text-zinc-100">Graph</a>
        <a href="/#apps" class="py-3 transition-colors hover:text-zinc-100">Apps</a>
        <a href="/#status" class="py-3 transition-colors hover:text-zinc-100">Status</a>
      </div>
    </nav>

    <StakeDialogHost client:load />

    <!--
      Every [data-stake-cta] link opens the on-site staking dialog instead of
      navigating. The event is cancelable and the host calls preventDefault() on
      it, so a click that arrives before the island hydrates — or with the island
      unavailable — simply follows the href to nimiq.com/staking.
    -->
    <script is:inline>
      document.addEventListener('click', function (event) {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        var target = event.target instanceof Element ? event.target.closest('[data-stake-cta]') : null;
        if (!target) return;
        var request = new CustomEvent('open-stake-dialog', {
          cancelable: true,
          detail: { source: target.getAttribute('data-stake-cta') || '' },
        });
        document.dispatchEvent(request);
        if (request.defaultPrevented) event.preventDefault();
      });
    </script>
  </body>
</html>
